# Copy this file to ".env.local" for running on your own PC.
# On Vercel, add the same three values under Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" connection string (port 6543),
# with [YOUR-PASSWORD] replaced by your database password. Keep the quotes in
# this file (a # in the password would otherwise start a comment). On Vercel,
# paste the value without quotes.
DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# A long random string (at least 32 characters). Used to sign login cookies.
SESSION_SECRET=replace-me-with-a-long-random-string-of-48-characters

# The password you type to log in as the DM.
DM_PASSWORD=choose-a-dm-password
